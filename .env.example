# ============================================================
# Oman Rooftop Solar Estimator - Environment Variables
# Copy this file to .env.local and fill in values as needed.
# ============================================================

# OPTIONAL: Mapbox access token.
# If set:
#   - the satellite map uses Mapbox Satellite v9 tiles, and
#   - search uses Mapbox Geocoding (richest data, closest to Google Maps,
#     e.g. can find named POIs like "Al Qurum Complex").
# If empty/omitted, the map falls back to Esri World Imagery (free, no key)
# and search falls back to Photon -> Nominatim (free OpenStreetMap data).
# Get a free token at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=

# OPTIONAL: Override the default Oman grid emission factor
# in tonnes of CO2 per MWh (Oman grid: 0.65 tCO2/MWh, mostly gas-fired).
NEXT_PUBLIC_GRID_EMISSION_FACTOR=0.65

# OPTIONAL: Override the default solar installation cost in OMR per kWp.
# Knowledge-base baseline 300 OMR/kWp; turnkey market range ~250 - 350 OMR/kWp.
NEXT_PUBLIC_COST_PER_KWP=300

# OPTIONAL: Nominal geocoding API (Nominatim / OpenStreetMap).
# Used for address search on the map. Free, no key required.
NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org
